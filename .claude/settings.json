{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(PYTHONPATH=src .venv/Scripts/python.exe -m pytest*)",
      "Bash(.venv/Scripts/python.exe -m pytest*)",
      "Bash(.venv/Scripts/python.exe -m ruff check*)",
      "Bash(.venv/Scripts/python.exe -m pip_audit*)",
      "Bash(.venv/Scripts/python.exe scripts/check_internal_links.py*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git blame*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Edit(config/data_model/approved_keys.yml)",
      "Edit(config/data_model/approved_relationships.yml)",
      "Write(config/data_model/approved_keys.yml)",
      "Write(config/data_model/approved_relationships.yml)",
      "Edit(originaldatabase/**)",
      "Write(originaldatabase/**)",
      "Edit(outputs/**)",
      "Write(outputs/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Write(.env)"
    ],
    "ask": [
      "Bash(*live_provider*)",
      "Bash(*benchmark-export-sqlserver*)",
      "Bash(*analytics-nl-translate-ollama*)",
      "Bash(*analytics-dataset-benchmark-evaluate-ollama*)",
      "Bash(*analytics-ollama-soak*)",
      "Bash(*apply-approvals*)",
      "Bash(*apply-product-refnr-decisions*)",
      "Bash(*analytics-semantic-approval*)",
      "Bash(*analytics-dataset-benchmark-approval*)"
    ]
  },
  "worktree": {
    "baseRef": "fresh",
    "sparsePaths": [
      "src",
      "tests",
      "docs",
      "scripts",
      "config",
      ".codex",
      ".github"
    ]
  }
}
